# Copy to .env.local and fill ONE of these to run the Phase 2 crawler (pnpm crawl).
# Free key: https://www.themoviedb.org/settings/api

# v4 read access token (recommended)
TMDB_BEARER=

# or v3 api key
# TMDB_API_KEY=

# --- Event storage (Supabase) ---
# Leave BOTH blank to store events in a local file (data/events.jsonl).
# Fill BOTH to store events in Supabase (needed once deployed). See DEPLOY.md.
# service_role key is server-only -- never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
